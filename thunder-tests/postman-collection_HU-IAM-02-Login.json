  "item": [
    {
      "name": "CA1 - Inicio de Sesión Exitoso",
      "item": [
        {
          "name": "CA1-01: Login Exitoso - Rol Transportista",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Tipo de token es bearer', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token_type.toLowerCase()).to.eql('bearer');",
                  "});",
                  "pm.test('Rol es TRANSPORTISTA', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.rol).to.eql('TRANSPORTISTA');",
                  "});",
                  "pm.test('Entrega access_token no vacio', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan.perez@rutanorte.cl\",\n  \"password\": \"camion123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
