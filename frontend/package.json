{
  "name": "Camiones_contratos",
  "version": "1.0.0",
  "description": "Aplicación de escritorio desarrollada con Electron, Node.js, TypeScript y python",
  "main": "dist/main.js",
  "author": "Equipo MansoViaje",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "dev": "tsc --watch",
    "test:panel": "node tests/e2e/panel.e2e.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "npm install --include=dev",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cpx": "^1.5.0",
    "electron": "^44.0.0",
    "electron-builder": "26.18.0",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
