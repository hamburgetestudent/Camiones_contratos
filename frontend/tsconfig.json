{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "electron",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node", "electron"]
  },
  "files": ["electron/main.ts"],
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
